{
	"name": "web",
	"version": "0.1.0",
	"private": true,
	"description": "Svelocity web shell — SvelteKit + Convex + Shared Tasks demo, deploys to Cloudflare.",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"convex:dev": "pnpm --filter @svelocity/backend dev",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@svelocity/app-core": "workspace:*",
		"@svelocity/auth": "workspace:*",
		"@svelocity/backend": "workspace:*",
		"@svelocity/env": "workspace:*",
		"@svelocity/theme": "workspace:*",
		"@svelocity/ui": "workspace:*",
		"convex": "catalog:",
		"convex-svelte": "catalog:"
	},
	"devDependencies": {
		"@axe-core/playwright": "catalog:",
		"@playwright/test": "catalog:",
		"@svelocity/config": "workspace:*",
		"@sveltejs/adapter-cloudflare": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
