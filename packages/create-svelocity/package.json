{
	"name": "create-svelocity",
	"version": "1.0.0",
	"description": "Scaffold a Svelocity Stack project — web, desktop, and mobile from one shared core.",
	"license": "MIT",
	"homepage": "https://github.com/AddeyX/Svelocity-Stack#readme",
	"bugs": {
		"url": "https://github.com/AddeyX/Svelocity-Stack/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AddeyX/Svelocity-Stack.git",
		"directory": "packages/create-svelocity"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"electron",
		"capacitor",
		"convex",
		"monorepo",
		"scaffold"
	],
	"type": "module",
	"bin": {
		"create-svelocity": "./dist/create.js",
		"svelocity": "./dist/cli.js"
	},
	"files": [
		"dist",
		"template"
	],
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"build:template": "node scripts/build-template.mjs",
		"build": "pnpm build:template && tsdown",
		"check": "tsc -p tsconfig.json",
		"start": "node dist/create.js",
		"test": "vitest run",
		"prepublishOnly": "pnpm build"
	},
	"devDependencies": {
		"@clack/prompts": "1.6.0",
		"@svelocity/config": "workspace:*",
		"@types/node": "catalog:",
		"@types/validate-npm-package-name": "^4.0.2",
		"citty": "^0.2.2",
		"picocolors": "^1.1.1",
		"tsdown": "^0.22.3",
		"typescript": "catalog:",
		"validate-npm-package-name": "^8.0.0",
		"vitest": "catalog:"
	}
}
